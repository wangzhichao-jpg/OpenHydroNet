{
  "name": "openhydronet",
  "version": "0.1.0-preview.3",
  "private": true,
  "description": "离线中文供热与空调水系统分析",
  "license": "Apache-2.0",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --config web/vite.config.ts --host 127.0.0.1",
    "build": "tsc --project web/tsconfig.json && vite build --config web/vite.config.ts",
    "desktop": "electron .",
    "setup:desktop": "node node_modules/electron/install.js",
    "test:ui": "node tests/ui.e2e.cjs",
    "test:commands": "tsx --test web/src/*.test.ts && node --test tests/*.test.cjs",
    "test:graph": "node tests/ui.graph.cjs",
    "test:lifecycle": "node tests/ui.lifecycle.cjs",
    "test:features": "node tests/ui.features.cjs",
    "test:jobs": "node tests/ui.jobs.cjs",
    "test:analysis": "node tests/ui.analysis.cjs",
    "format:check": "prettier --check web/src desktop tests/*.cjs tools/*.cjs"
  },
  "dependencies": {
    "@xyflow/react": "12.8.5",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "44.9.1",
    "playwright": "1.64.1",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "6.4.4"
  }
}
